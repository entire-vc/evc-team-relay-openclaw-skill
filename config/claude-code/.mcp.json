{
  "_comment": "Choose ONE of: local (stdio) or remote (streamable-http). Delete the other.",

  "mcpServers": {
    "evc-relay-local": {
      "command": "uv",
      "args": ["run", "--directory", "/path/to/evc-team-relay-openclaw-skill", "relay_mcp.py"],
      "env": {
        "RELAY_CP_URL": "${RELAY_CP_URL}",
        "RELAY_EMAIL": "${RELAY_EMAIL}",
        "RELAY_PASSWORD": "${RELAY_PASSWORD}"
      }
    },
    "evc-relay-remote": {
      "type": "streamable-http",
      "url": "http://localhost:8888/mcp"
    }
  }
}
